{
  "name": "telegram-md-entities-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser demo: markdown <-> Telegram entities through the clipboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "rsync -avz --delete dist/ \"$DEMO_DEPLOY_TARGET\"/"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
